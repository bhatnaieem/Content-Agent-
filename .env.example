# AgentRouter API Key (Get yours from agentrouter.org)
AGENTROUTER_API_KEY=your_agentrouter_api_key_here

# Optional: Preferred model override (e.g. gpt-4o, claude-3-5-sonnet)
DEFAULT_MODEL=gpt-4o

# Private workspace protection
# AUTH_SECRET must be a long random value of at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret
# Password required to access the CryptoPulse dashboard.
AUTH_PASSWORD=replace-with-your-workspace-password
